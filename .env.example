# Copiar a .env y establecer valores propios antes de publicar.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
SITE_URL=http://127.0.0.1:8000

# Email de desarrollo: consola. Para SMTP cambiar EMAIL_BACKEND.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Cine de Cortos <no-reply@example.com>

DATABASE_PATH=db.sqlite3
MEDIA_ROOT=media
BOOKING_CUTOFF_MINUTES=60
MAX_TICKETS_PER_BOOKING=8

# Producción: DJANGO_DEBUG=0, DJANGO_ALLOWED_HOSTS=tu-dominio,
# SITE_URL=https://tu-dominio, SECURE_SSL_REDIRECT=1
